KNBS_SURVEY_2024=https://www.knbs.or.ke/wp-content/uploads/2024/05/2024-Economic-Survey.pdf
KNBS_SURVEY_2025=https://www.knbs.or.ke/wp-content/uploads/2025/05/Chapter-3-Employment-Earnings-and-Consumer-Price-Indices.xlsx